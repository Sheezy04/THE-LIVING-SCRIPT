// Cloudflare Worker「the-living-script」的部署配置。
//
// 一个域同时给网页与问答接口：/api/* 走 worker/index.mjs，
// 其余交给静态资源（assets 绑定），前端因此不需要知道后端在哪（它调相对路径）。
//
// ⚠️ name 必须与后台现有 Worker 同名。改了名不会「转移」部署，而是凭空多一个 Worker，
//    而 docs/ 里公布的地址仍指向旧的那个。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-living-script",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  // 静态资源就是仓库根：index.html、src/、data/、assets/。
  // 谁不该被发布由根目录的 .assetsignore 决定（server/、worker/、.git 等都在那里排掉）。
  "assets": { "directory": ".", "binding": "ASSETS" },
  // 与 Node 侧同名同默认值；密钥不在仓库里，DEEPSEEK_API_KEY 请在后台按 Secret 添加。
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-flash",
    "ASK_RATE_LIMIT": "8",
    "ASK_DAILY_LIMIT": "200",
    "ASK_CONCURRENCY": "4",
    "ASK_TIMEOUT_MS": "40000"
  },
  "observability": { "enabled": true }
}
