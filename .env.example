# Copy to .env for local use, or set these variables in your hosting platform.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=4173
# Set to your real HTTPS origin before publishing (no trailing slash/path).
PUBLIC_ORIGIN=
ASK_RATE_LIMIT=8
ASK_DAILY_LIMIT=200
ASK_CONCURRENCY=4
ASK_TIMEOUT_MS=40000
# Enable only behind a trusted proxy that OVERWRITES X-Forwarded-For.
TRUST_PROXY=false
